#!/bin/bash
#PBS -P tp66
#PBS -q normalsr
#PBS -N est_xxlNEGMm
#PBS -l ncpus=4160
#PBS -l mem=19200GB
#PBS -l walltime=7:00:00
#PBS -l jobfs=1600GB
#PBS -l storage=scratch/tp66+gdata/tp66
#PBS -l wd
#PBS -o /g/data/tp66/logs/durables/
#PBS -e /g/data/tp66/logs/durables/

# ---------------------------------------------------------------
# XXL NEGM (2x xlarge cores) MALES : 600-grid, 4160 samples (= n_samples), 40 normalsr nodes
# NEGM on the adjuster upper envelope via --methods-override; spec otherwise as xxl EGM males.
# Estimated cost: 2.0 SU x 4160 cores x 7h = 58240 SU max (charged as used)
# Runs CE-SMM in ITERS_PER_RESTART-iter checkpointed segments until the
# optimiser converges/errors OR the 7h walltime is exhausted (as many
# iterations as possible). Process restarted each segment to release RSS.
# ---------------------------------------------------------------

MOD="${MOD:-syntax/separable}"
SPEC="${SPEC:-baseline_xlarge_negm_males.yaml}"
SPEC_FACTORY="${SPEC_FACTORY:-spec_factory_males.yaml}"
METHODS="--methods-override adjuster_cons.upper_env.upper_envelope=NEGM"
GRID="${GRID:-600}"
N_SIM="${N_SIM:-10000}"

module purge
module load python3/3.12.1
module load openmpi/4.1.5

# Locate the repo root: walk up from the submission directory until
# pyproject.toml is found, so the script can live at any depth under it.
REPO_ROOT="$PBS_O_WORKDIR"
while [ ! -f "$REPO_ROOT/pyproject.toml" ] && [ "$REPO_ROOT" != "/" ]; do
    REPO_ROOT="$(dirname "$REPO_ROOT")"
done
if [ ! -f "$REPO_ROOT/pyproject.toml" ]; then
    echo "ERROR: Cannot find repo root above PBS_O_WORKDIR=$PBS_O_WORKDIR" >&2; exit 1
fi
echo "  Repo root: $REPO_ROOT"

# Import from the repo but do not run inside it: a core file or any other
# stray output then lands on scratch, not on the 10 GiB home quota.
export PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"
RUN_DIR="${RUN_DIR:-/scratch/tp66/$USER/durables_est/jobs/${PBS_JOBID%%.*}}"
mkdir -p "$RUN_DIR"
cd "$RUN_DIR"
echo "  Run dir:   $(pwd)"

# --- Stage the Python environment on every node's local disk -----------------
# With twelve 4,160-rank jobs re-importing the stack from the venv on /home
# at every segment start, NFS stat calls took 0.1-0.5 s each and a segment's
# start-up grew from ~3 to 20+ minutes (measured 28 Sep 2026, 03:45). One copy
# of the venv and of examples/ + src/ per node, then every import is local.
STAGE="${STAGE:-$PBS_JOBFS/fues_env}"
NNODES="$(sort -u "$PBS_NODEFILE" | wc -l)"
echo "  Staging venv + repo onto jobfs of $NNODES node(s) at $(date +%H:%M:%S)"
mpiexec -n "$NNODES" --map-by ppr:1:node \
    bash -c 'set -e; mkdir -p "$1/repo"; cp -r "$HOME/venvs/fues" "$1/venv"; cp -r "$2/examples" "$2/src" "$1/repo/"' _ "$STAGE" "$REPO_ROOT"
[ -x "$STAGE/venv/bin/python3" ] || { echo "ERROR: staging the venv on $STAGE failed" >&2; exit 1; }
export VIRTUAL_ENV="$STAGE/venv"
export PATH="$STAGE/venv/bin:$PATH"
export PYTHONPATH="$STAGE/repo/src:$STAGE/repo"
export PYTHONDONTWRITEBYTECODE=1
echo "  Staged at $(date +%H:%M:%S): python=$(command -v python3)"
RESULTS_ROOT="${RESULTS_ROOT:-/g/data/tp66/results/durables/estimation}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMBA_NUM_THREADS=1
export NUMBA_THREADING_LAYER=workqueue
export MALLOC_MMAP_THRESHOLD_=65536
export MALLOC_TRIM_THRESHOLD_=0
export PYTHONMALLOC=malloc
export OPENBLAS_NUM_THREADS=1
export NUMBA_CACHE_DIR=$PBS_JOBFS/numba_cache
mkdir -p $NUMBA_CACHE_DIR
export OMPI_MCA_coll_hcoll_enable=0
# UCC excluded alongside hcoll: on 23 Sep 2026 (job 179615514) 146 ranks died
# with SIGBUS inside UCC's shared-memory collectives as nodes ran out of memory.
export OMPI_MCA_coll_ucc_enable=0
export OMPI_MCA_coll=^hcoll,ucc
export PMIX_MCA_gds=hash

echo "Starting XXL NEGM (2x xlarge cores) MALES estimation at $(date)"
echo "  Mod: $MOD | Spec: $SPEC | Factory: $SPEC_FACTORY | Grid: $GRID | Cores: $PBS_NCPUS"

# --- Time-bounded restart loop --------------------------------------------
ITERS_PER_RESTART="${ITERS_PER_RESTART:-3}"
WALL_SECONDS="${WALL_SECONDS:-25200}"   # default matches #PBS -l walltime; pass WALL_SECONDS with qsub -l walltime=… to shorten
SAFETY_BUFFER=600               # reserve 10 min for final checkpoint
START_TS=$(date +%s)
DEADLINE=$((START_TS + WALL_SECONDS - SAFETY_BUFFER))
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)}"   # pass RUN_ID=<earlier run id> with RESUME=1 to continue a checkpointed run

# --- Run manifest: what this job is, written next to its results ------------
# One JSON per run at $RESULTS_ROOT/<mod>/<spec stem>/manifest_est_<run id>.json
# and one line in $RESULTS_ROOT/manifests/runs.csv, so every result folder can
# be tied back to its job, commit, spec and overrides.
SCRIPT_NAME="run_xxl_negm_males.pbs"
EXTRA_SETTINGS="${EXTRA_SETTINGS:-}"            # e.g. "h_max=15;w_max=17.5" (';' separated)
NRANKS="${NRANKS:-$PBS_NCPUS}"                  # MPI ranks (= CE samples); default one per core
PPR="${PPR:-13}"                                 # ranks per NUMA domain (fewer = more memory per rank)
PURPOSE="${PURPOSE:-}"
MOD_NAME="$(basename "$MOD")"; SPEC_STEM="${SPEC%.yaml}"
MANIFEST_DIR="$RESULTS_ROOT/$MOD_NAME/$SPEC_STEM"
mkdir -p "$MANIFEST_DIR" "$RESULTS_ROOT/manifests"
GIT_COMMIT="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
STARTED="$(date +%Y-%m-%dT%H:%M:%S%z)"
cat > "$MANIFEST_DIR/manifest_est_${RUN_ID}_job${PBS_JOBID%%.*}.json" <<MANIFEST_EOF
{
  "run_id": "est_$RUN_ID", "job_id": "${PBS_JOBID%%.*}", "job_name": "$PBS_JOBNAME",
  "script": "$SCRIPT_NAME", "git_commit": "$GIT_COMMIT",
  "mod": "$MOD", "spec": "$SPEC", "spec_factory": "${SPEC_FACTORY:-}",
  "grid": "$GRID", "n_sim": "$N_SIM", "extra_settings": "$EXTRA_SETTINGS",
  "methods": "${METHODS:-}", "nranks": "$NRANKS", "ppr": "$PPR",
  "iters_per_restart": "$ITERS_PER_RESTART", "wall_seconds": "$WALL_SECONDS",
  "ncpus": "$PBS_NCPUS", "queue": "${PBS_QUEUE:-}", "started": "$STARTED",
  "submitted_from": "$PBS_O_WORKDIR", "purpose": "$PURPOSE", "resumed": "${RESUME:-0}"
}
MANIFEST_EOF
CSV="$RESULTS_ROOT/manifests/runs.csv"
[ -f "$CSV" ] || echo "run_id,job_id,job_name,script,git_commit,mod,spec,spec_factory,grid,n_sim,extra_settings,methods,nranks,ppr,iters_per_restart,wall_seconds,ncpus,started,purpose" > "$CSV"
echo "est_$RUN_ID,${PBS_JOBID%%.*},$PBS_JOBNAME,$SCRIPT_NAME,$GIT_COMMIT,$MOD,$SPEC,${SPEC_FACTORY:-},$GRID,$N_SIM,$EXTRA_SETTINGS,${METHODS:-},$NRANKS,$PPR,$ITERS_PER_RESTART,$WALL_SECONDS,$PBS_NCPUS,$STARTED,$PURPOSE" >> "$CSV"
echo "  Variant: spec=$SPEC | N_SIM=$N_SIM | ranks=$NRANKS | ppr=$PPR | iters/segment=$ITERS_PER_RESTART | extra settings=${EXTRA_SETTINGS:-none} | methods=${METHODS:-default}"
echo "  Manifest: $MANIFEST_DIR/manifest_est_${RUN_ID}_job${PBS_JOBID%%.*}.json"

RESTART_NUM=0
RESUME_FLAG="${RESUME:+--resume}"
EXIT_CODE=0
LAST_SEG_DUR=0

while : ; do
    NOW=$(date +%s)
    REMAINING=$((DEADLINE - NOW))
    if [ $REMAINING -le 0 ]; then
        echo "=== Walltime budget exhausted after $RESTART_NUM segments; stopping. ==="
        break
    fi
    if [ $RESTART_NUM -gt 0 ] && [ $REMAINING -lt $LAST_SEG_DUR ]; then
        echo "=== ${REMAINING}s left < last segment ${LAST_SEG_DUR}s; stopping before walltime kill. ==="
        break
    fi
    RESTART_NUM=$((RESTART_NUM + 1))
    echo ""
    echo "=== Restart segment $RESTART_NUM at $(date) (${REMAINING}s of budget left) ==="
    SEG_START=$(date +%s)

    mpiexec -n "$NRANKS" \
        --map-by "ppr:$PPR:numa" \
        bash -c 'ulimit -c 0; exec python3 -u -m mpi4py -m examples.durables.estimate "$@"' _ \
            --mod "$MOD" \
            --spec "$SPEC" \
            --spec-factory "$SPEC_FACTORY" \
            --scratch /scratch/tp66/$USER/durables_est \
            --results "$RESULTS_ROOT" \
            --local-results none \
            --settings-override n_a=$GRID n_h=$GRID n_w=$GRID ${EXTRA_SETTINGS//;/ } \
            --params-override t0=20 \
            --N-sim $N_SIM \
            --max-iter 100000 \
            --max-iter-this-run $ITERS_PER_RESTART \
            --run-id $RUN_ID \
            $METHODS \
            $RESUME_FLAG

    EXIT_CODE=$?
    LAST_SEG_DUR=$(( $(date +%s) - SEG_START ))
    echo "=== Segment $RESTART_NUM exit code: $EXIT_CODE (took ${LAST_SEG_DUR}s) ==="

    if [ $EXIT_CODE -ne 42 ]; then
        if [ $EXIT_CODE -ne 0 ]; then
            echo "ERROR: mpiexec exited with code $EXIT_CODE"
        else
            echo "Estimation complete (converged or max-iter reached)."
        fi
        break
    fi
    RESUME_FLAG="--resume"
done

echo "Finished at $(date). Total restart segments: $RESTART_NUM"

if [ $EXIT_CODE -ne 0 ] && [ $EXIT_CODE -ne 42 ]; then
    exit $EXIT_CODE
fi
