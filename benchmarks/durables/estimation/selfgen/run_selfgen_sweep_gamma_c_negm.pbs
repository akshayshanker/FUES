#!/bin/bash
#PBS -P tp66
#PBS -q normalsr
#PBS -N sw_gamC_NEGM
#PBS -l ncpus=5200
#PBS -l mem=24000GB
#PBS -l walltime=5:00:00
#PBS -l jobfs=2000GB
#PBS -l storage=scratch/tp66+gdata/tp66
#PBS -l wd
#PBS -o /g/data/tp66/logs/durables/
#PBS -e /g/data/tp66/logs/durables/

# ---------------------------------------------------------------
# SELFGEN SWEEP over gamma_c (NEGM): 10 values, 1040 ranks
# ~104 ranks per estimation point.
# ---------------------------------------------------------------

MOD="syntax/separable"
SPEC="selfgen_sweep_gamma_c_negm.yaml"
GRID=300
N_SIM=10000

module purge
module load python3/3.12.1
module load openmpi/4.1.5

# Locate the repo root: walk up from the submission directory until
# pyproject.toml is found, so the script can live at any depth under it.
REPO_ROOT="$PBS_O_WORKDIR"
while [ ! -f "$REPO_ROOT/pyproject.toml" ] && [ "$REPO_ROOT" != "/" ]; do
    REPO_ROOT="$(dirname "$REPO_ROOT")"
done
if [ ! -f "$REPO_ROOT/pyproject.toml" ]; then
    echo "ERROR: Cannot find repo root above PBS_O_WORKDIR=$PBS_O_WORKDIR" >&2; exit 1
fi
echo "  Repo root: $REPO_ROOT"

# Import from the repo but do not run inside it: a core file or any other
# stray output then lands on scratch, not on the 10 GiB home quota.
export PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"
RUN_DIR="${RUN_DIR:-/scratch/tp66/$USER/durables_est/jobs/${PBS_JOBID%%.*}}"
mkdir -p "$RUN_DIR"
cd "$RUN_DIR"
echo "  Run dir:   $(pwd)"

source "$HOME/venvs/fues/bin/activate"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMBA_NUM_THREADS=1
export NUMBA_THREADING_LAYER=workqueue

# Force large allocations through mmap (returned to OS on free).
# Prevents glibc malloc fragmentation that causes RSS growth across iterations.
export MALLOC_MMAP_THRESHOLD_=65536
export MALLOC_TRIM_THRESHOLD_=0
export PYTHONMALLOC=malloc
export OPENBLAS_NUM_THREADS=1
export NUMBA_CACHE_DIR=$PBS_JOBFS/numba_cache
mkdir -p $NUMBA_CACHE_DIR
find "$HOME/venvs/fues/lib/" -name "*.nbc" -o -name "*.nbi" 2>/dev/null | xargs rm -f 2>/dev/null
export OMPI_MCA_coll_hcoll_enable=0
# UCC excluded alongside hcoll: on 23 Sep 2026 (job 179615514) 146 ranks died
# with SIGBUS inside UCC's shared-memory collectives as nodes ran out of memory.
export OMPI_MCA_coll_ucc_enable=0
export OMPI_MCA_coll=^hcoll,ucc
export PMIX_MCA_gds=hash

echo "Starting SELFGEN SWEEP gamma_c (NEGM) at $(date)"
echo "  Mod: $MOD | Spec: $SPEC | Grid: $GRID | Nodes: $((PBS_NCPUS/104)) | Cores: $PBS_NCPUS"

ITERS_PER_RESTART=10             # 104 ranks/node at <=4.6 GB each; rank RSS grows ~60 MB/iter
WALL_SECONDS=18000              # must match #PBS -l walltime=5:00:00 (5h)
SAFETY_BUFFER=600               # reserve 10 min for final checkpoint
START_TS=$(date +%s)
DEADLINE=$((START_TS + WALL_SECONDS - SAFETY_BUFFER))
RUN_ID=$(date +%Y%m%d_%H%M%S)

RESTART_NUM=0
RESUME_FLAG=""
EXIT_CODE=0
LAST_SEG_DUR=0

while : ; do
    NOW=$(date +%s)
    REMAINING=$((DEADLINE - NOW))
    if [ $REMAINING -le 0 ]; then
        echo "=== Walltime budget exhausted after $RESTART_NUM segments; stopping. ==="
        break
    fi
    if [ $RESTART_NUM -gt 0 ] && [ $REMAINING -lt $LAST_SEG_DUR ]; then
        echo "=== ${REMAINING}s left < last segment ${LAST_SEG_DUR}s; stopping before walltime kill. ==="
        break
    fi
    RESTART_NUM=$((RESTART_NUM + 1))
    echo ""
    echo "=== Restart segment $RESTART_NUM at $(date) (${REMAINING}s of budget left) ==="
    SEG_START=$(date +%s)

    mpiexec -n $PBS_NCPUS \
        --map-by ppr:13:numa \
        bash -c 'ulimit -c 0; exec python3 -u -m mpi4py -m examples.durables.estimate "$@"' _ \
            --mod "$MOD" \
            --spec "$SPEC" \
            --scratch /scratch/tp66/$USER/durables_est \
            --results /g/data/tp66/results/durables/estimation \
            --local-results none \
            --settings-override n_a=$GRID n_h=$GRID n_w=$GRID \
            --params-override t0=20 \
            --N-sim $N_SIM \
            --methods-override adjuster_cons.cntn_to_dcsn_mover.upper_envelope=NEGM \
            --max-iter 100000 \
            --max-iter-this-run $ITERS_PER_RESTART \
            --run-id $RUN_ID \
            $RESUME_FLAG

    EXIT_CODE=$?
    LAST_SEG_DUR=$(( $(date +%s) - SEG_START ))
    echo "=== Segment $RESTART_NUM exit code: $EXIT_CODE (took ${LAST_SEG_DUR}s) ==="

    if [ $EXIT_CODE -ne 42 ]; then
        if [ $EXIT_CODE -ne 0 ]; then
            echo "ERROR: mpiexec exited with code $EXIT_CODE"
        else
            echo "Estimation complete (converged or max-iter reached)."
        fi
        break
    fi
    RESUME_FLAG="--resume"
done

echo "Total restart segments: $RESTART_NUM"

echo "Finished at $(date)"

if [ $EXIT_CODE -ne 0 ] && [ $EXIT_CODE -ne 42 ]; then
    exit $EXIT_CODE
fi
